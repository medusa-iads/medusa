direction: down

title: MANPAD alertness and engagement state machine {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

state: {
  label: Manpad.SleepWakeState
  direction: down
  style: {
    fill: "#f3f8f1"
    stroke: "#5f7956"
    border-radius: 6
  }

  asleep: ASLEEP {
    style.fill: "#f5f5f5"
    style.stroke: "#666666"
    style.stroke-width: 3
  }
  alerting: ALERTING
  alert: ALERT
  hot: HOT {
    style.fill: "#e8f6e8"
    style.stroke: "#39814a"
    style.stroke-width: 3
  }
  cooldown: COOLDOWN

  asleep -> alerting: IADS cue or neighbor radio wake
  alerting -> alert: wake timer completes
  alert -> hot: visible aircraft inside the weapon envelope
  hot -> hot: shot extends HOT by 5–15 minutes
  hot -> cooldown: HOT deadline and goCold succeeds
  cooldown -> alert: 15-minute recovery
  alert -> asleep: 15-minute idle
}

external: {
  label: External transitions
  direction: down
  style: {
    fill: "#f5f5f5"
    stroke: "#666666"
    border-radius: 6
  }

  rearm: Rearm completes
  cancel: Cancel pending wake
  detection: "Local detection\nAudio or eligible HOT_WAR visual"
}

external.rearm -> state.alert: cancel wake and recover {
  style.stroke: "#666666"
  style.stroke-width: 3
}
external.cancel -> state.asleep: ALERTING returns to ASLEEP {
  style.stroke: "#666666"
  style.stroke-width: 3
}
external.detection -> state.alert: immediate wake {
  style.stroke: "#3767a6"
  style.stroke-width: 3
}
